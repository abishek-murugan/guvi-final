# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
.uv/

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Test / coverage artifacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# Raw & processed data (privacy: never commit user browsing data)
data/raw/*
data/processed/*
data/models/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/models/.gitkeep

# Logs
logs/*
*.log
!logs/.gitkeep

# Reports
reports/*
!reports/.gitkeep

# Jupyter / IDE
.ipynb_checkpoints/
.idea/
.vscode/
*.swp
.DS_Store

# Secrets / env
.env
.env.*
